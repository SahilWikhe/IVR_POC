# Local synthetic demo. Never commit .env or paste secrets into chat.
NODE_ENV=development
AUTH_MODE=demo
API_HOST=127.0.0.1
API_PORT=3001
DASHBOARD_ORIGIN=http://127.0.0.1:5173
HOSTLINE_DATA_DIR=.data/hostline
# Optional in local demo; required for OIDC. Generate >=32 random characters.
# SESSION_SECRET=
# SESSION_ENCRYPTION_SECRET=

# Separate PostgreSQL/OIDC development environment (no automatic demo seeding).
# AUTH_MODE=oidc
# DATABASE_URL=postgresql://runtime_identity:password@localhost:5432/hostline
# DATABASE_MIGRATION_URL=postgresql://migration_identity:password@localhost:5432/hostline
# OIDC_ISSUER=https://identity.example
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://dashboard.example/api/auth/callback
# Memberships are durable: use pnpm identity:ops; never configure OIDC_MEMBERSHIPS.
OIDC_REQUIRE_MFA=true
# DATABASE_CA_FILE=/opt/hostline/certs/rds-global-bundle.pem
# DASHBOARD_STATIC_DIR=apps/dashboard/dist
# API_TRUSTED_PROXY_CIDRS=10.42.0.0/24,10.42.1.0/24,10.42.10.0/24,10.42.11.0/24
# RUN_INTERNAL_JOBS=false # native/OIDC default; embedded demo defaults true

# AWS native runtimes require independent recovery authorization; see privacy docs.
# AWS_REGION=
# RECOVERY_TABLE_NAME=
# RECOVERY_INSTALLATION_ID=
# RECOVERY_EPOCH=
# RECOVERY_DATABASE_INSTANCE_ID=
# RECOVERY_DATABASE_RESOURCE_ID=
# DATABASE_PRIVACY_URL=

# Isolated phone sandbox; all voice features off by default. See docs/VOICE_SETUP.md.
LIVE_VOICE_ENABLED=false
VOICE_MODE=sandbox
VOICE_HOST=127.0.0.1
VOICE_PORT=3002
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# OPENAI_API_KEY=
# Voice model selector (legacy environment name retained for compatibility).
OPENAI_REALTIME_MODEL=gpt-live-1
OPENAI_VOICE_BACKEND_MODEL=gpt-6-luna
# VOICE_PUBLIC_URL=https://voice-test.example
API_INTERNAL_URL=http://127.0.0.1:3001
# Generate a random shared service token >=32 characters; set on API and voice gateway.
# VOICE_SERVICE_TOKEN=
# Only use this synthetic restaurant for demo test calls.
VOICE_TENANT_ID=11111111-1111-4111-8111-111111111111
VOICE_MAX_CONCURRENT_CALLS=2
VOICE_MAX_CALL_SECONDS=300
# Separate opt-in gates for isolated test-number request collection and transfers.
VOICE_ACTIONS_ENABLED=false
VOICE_TRANSFERS_ENABLED=false
# Local GPT-Live test transcripts only: private .data/voice-transcripts, 24-hour expiry.
# Contains caller text/contact details; never enable for customer traffic.
VOICE_DEBUG_TRANSCRIPTS=false
