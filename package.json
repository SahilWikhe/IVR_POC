{
  "name": "hostline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:dashboard": "pnpm --filter @hostline/dashboard dev",
    "dev:voice": "tsx watch apps/voice-gateway/src/index.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "identity:ops": "node --import tsx scripts/identity-access.mjs",
    "privacy:ops": "node --import tsx scripts/privacy-ops.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:native": "node scripts/test-native.mjs",
    "build": "node scripts/build.mjs && pnpm --filter @hostline/dashboard build",
    "start": "node apps/api/dist/index.js",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm security:check && pnpm test && pnpm build",
    "security:check": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1142.0",
    "@aws-sdk/client-rds": "3.1142.0",
    "@aws-sdk/lib-dynamodb": "3.1142.0",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@fastify/cookie": "^11.0.0",
    "@hostline/config": "workspace:*",
    "@hostline/connectors": "workspace:*",
    "@hostline/contracts": "workspace:*",
    "@hostline/database": "workspace:*",
    "@hostline/domain": "workspace:*",
    "@js-temporal/polyfill": "^0.5.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.0",
    "agent-browser": "0.38.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "fastify": "5.12.5",
    "globals": "^16.0.0",
    "openid-client": "^6.8.0",
    "pg": "^8.18.0",
    "prettier": "^3.8.0",
    "tsx": "^4.21.0",
    "twilio": "^5.12.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.55.0",
    "vitest": "5.0.3",
    "ws": "^8.19.0",
    "zod": "^4.3.0"
  }
}
